CREATE OR REPLACE TABLE
  `kimia-farma-2020-2023-510316.kimia_farma.analisis_kimia_farma` AS
SELECT
  t.transaction_id,
  t.date,
  t.branch_id,
  c.branch_name,
  c.kota,
  c.provinsi,
  c.rating AS rating_cabang,
  t.customer_name,
  t.product_id,
  p.product_name,

  -- Harga aktual produk
  t.price AS actual_price,

  -- Persentase diskon
  t.discount_percentage,

  -- Persentase gross laba berdasarkan harga
  CASE
    WHEN t.price <= 50000 THEN 0.10
    WHEN t.price <= 100000 THEN 0.15
    WHEN t.price <= 300000 THEN 0.20
    WHEN t.price <= 500000 THEN 0.25
    ELSE 0.30
  END AS persentase_gross_laba,

  -- Penjualan bersih setelah diskon
  t.price * (1 - t.discount_percentage) AS nett_sales,

  -- Keuntungan berdasarkan penjualan bersih
  t.price * (1 - t.discount_percentage) *
  CASE
    WHEN t.price <= 50000 THEN 0.10
    WHEN t.price <= 100000 THEN 0.15
    WHEN t.price <= 300000 THEN 0.20
    WHEN t.price <= 500000 THEN 0.25
    ELSE 0.30
  END AS nett_profit,

  -- Rating transaksi
  t.rating AS rating_transaksi

FROM
  `kimia-farma-2020-2023-510316.kimia_farma.kf_final_transaction` AS t

LEFT JOIN
  `kimia-farma-2020-2023-510316.kimia_farma.kf_kantor_cabang` AS c
  ON t.branch_id = c.branch_id

LEFT JOIN
  `kimia-farma-2020-2023-510316.kimia_farma.kf_product` AS p
  ON t.product_id = p.product_id;
